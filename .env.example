# ===========================================
# MONGODB CONFIGURATION
# ===========================================
MONGODB_URI=
DB_NAME=cpq_database

# ===========================================
# EMAIL CONFIGURATION (SendGrid)
# ===========================================
SENDGRID_API_KEY=
EMAIL_FROM=

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed CORS origins (production domains).
# In production set this to all frontend URLs, e.g.:
#   ALLOWED_ORIGINS=https://cpq.cftools.live,https://zenop.ai,https://www.zenop.ai
ALLOWED_ORIGINS=

# ===========================================
# FRONTEND CONFIGURATION (Localhost)
# ===========================================
VITE_API_URL=http://localhost:3001/api
VITE_BACKEND_URL=http://localhost:3001
VITE_MSAL_CLIENT_ID=
VITE_MSAL_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# App base URL for signing links in emails and redirects.
# Use 5173 when using Vite dev (npm run dev) so email links open the app on the same origin as Microsoft sign-in.
# Use 3001 when the app is served by the backend (e.g. production or npm run build + server).
APP_BASE_URL=http://localhost:5173

# ===========================================
# JWT CONFIGURATION
# ===========================================
# No default fallback should be used in production - generate a strong random secret.
JWT_SECRET=

# ===========================================
# DOCUMENTS API KEY (gates read-only /api/documents routes)
# ===========================================
# Static shared-secret for external read-only access to the Documents API (X-API-KEY header).
# Generate with: openssl rand -hex 32
DOCS_API_KEY=
# Frontend copy of the same value, sent as the X-API-KEY header by the Documents Manager UI.
# This is inlined into the built JS bundle at build time (import.meta.env.VITE_DOCS_API_KEY),
# so it is NOT secret from anyone using the app - keep it identical to DOCS_API_KEY above.
VITE_DOCS_API_KEY=

# ===========================================
# ONLYOFFICE CONFIGURATION (Redlines feature)
# ===========================================
# Leave empty for local dev - the OnlyOffice container runs with JWT_ENABLED=false,
# so the backend must send an UNSIGNED config. A non-empty value here makes the backend
# sign the editor config, which the container then rejects with
# "The document security token is not correctly formed."
# In production, set this to a strong secret AND set JWT_ENABLED=true on the container.
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_PUBLIC_URL=http://localhost:3003
ONLYOFFICE_INTERNAL_URL=http://localhost:3003
BACKEND_CALLBACK_URL=http://host.docker.internal:3001

# ===========================================
# LIBREOFFICE PATH (Windows: leave empty or set path; Mac: often /Applications/LibreOffice.app/Contents/MacOS/soffice)
# ===========================================
SOFFICE_PATH=

# ===========================================
# GOTENBERG (fast DOCX->PDF conversion microservice, ~1-2s vs ~8-10s direct LibreOffice)
# Start with: docker-compose up -d gotenberg  (publishes container :3000 on host :3004)
# ===========================================
GOTENBERG_URL=http://localhost:3004

# ===========================================
# LOCAL BASE URLS
# ===========================================
BASE_URL=http://localhost:5173

# ===========================================
# MICROSOFT CLARITY ANALYTICS
# ===========================================
VITE_CLARITY_ID=
VITE_CLARITY_ENABLE_DEV=1

# Comma-separated list of emails allowed to administer exhibits
EXHIBIT_ADMIN_EMAILS=

# ===========================================
# E-SIGNATURE ENCRYPTION
# ===========================================
# AES-256-GCM encrypted signature blobs in MongoDB (esign_signature_secrets).
# Must be exactly 64 hex characters (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESIGN_SIGNATURE_ENCRYPTION_KEY=

# ===========================================
# HUBSPOT
# ===========================================
HUBSPOT_API_KEY=
