# CPQ12 Commit Logic Explainer config.
# Copy this file to `.env.commit-explain` in the repo root and fill in real values there.
#
# This is a SEPARATE config file from:
#  - the project's root `.env`      (live production DB config — never conflate the two)
#  - /root/.cpq-monitor/monitor.env (the log monitor's config, a different feature)
# `.env.commit-explain` is gitignored; only this `.example` file is checked in.

# Optional. Bundled push-to-main explanations post here (informational only — this never
# triggers a deploy; `main` has no CI/CD pipeline). Leave empty to disable Teams posting; the
# hooks still print + log every explanation locally either way.
TEAMS_WEBHOOK_URL=

# Optional overrides. Sensible defaults are used when these are left empty:
#   COMMIT_REPO_DIR            -> the directory `git commit`/`git push` is run from
#   COMMIT_EXPLAIN_LOG_DIR     -> <repo>/logs/commit-explain
#   COMMIT_EXPLAIN_STATE_FILE  -> <repo>/logs/commit-explain/.state.json
COMMIT_REPO_DIR=
COMMIT_EXPLAIN_LOG_DIR=
COMMIT_EXPLAIN_STATE_FILE=

# --- AI explanation layer --------------------------------------------------
# Leave AI_PROVIDER empty to disable explanations entirely. The hooks still run and exit 0 on
# every commit/push either way — they simply print "explanation not available this run".
# Valid values: openai | anthropic
AI_PROVIDER=

# Only the key matching AI_PROVIDER is read. Leave BOTH empty in this example file.
# Real values go ONLY in your own .env.commit-explain (which is gitignored).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model. MUST be set to a model your key can actually access.
#   openai    -> suggested default: gpt-5.6-terra   (budget option: gpt-5.6-luna)
#   anthropic -> suggested default: claude-opus-5
# A wrong or inaccessible name gives a 404/400 -> the hook logs the rejected model name and
# prints "explanation not available this run", but the commit/push itself is never affected.
AI_MODEL=

# Optional. Override the API base URL. Use for Azure OpenAI, a proxy, or a local stub in testing.
AI_BASE_URL=

# Auth header style. Defaults from AI_PROVIDER; override only for Azure.
AI_AUTH_STYLE=

# Allow a plain-http and/or loopback AI_BASE_URL. Only for a local test stub.
AI_ALLOW_INSECURE=

# --- Shared limits (apply identically to both providers; enforced by resolveConfig()) ------
AI_EFFORT=low

# Repurposed here as "commits explained individually per push-to-main" — grouping does not
# apply to a single commit's diff the way it does to batched log lines. The rest of a large
# push gets one "+N more not individually explained" note instead of its own block. Range 0-100.
AI_MAX_GROUPS=8
AI_MAX_CHARS_PER_ERROR=400
AI_MAX_TOTAL_CHARS=6000
AI_MAX_MESSAGE_CHARS=8000
AI_MAX_CALLS_PER_DAY=40

# A commit SHA's diff is immutable, unlike a log line's fingerprint, so its cache entry can live
# far longer than the log monitor's. 43200 minutes = 30 days.
AI_CACHE_TTL_MIN=43200

# Lower than the log monitor's defaults: this runs SYNCHRONOUSLY in a developer's terminal
# during `git commit` / `git push`, not on an unattended cron job — it must return quickly.
# Clamped in code: AI_TIMEOUT_MS to 1s-60s, AI_TOTAL_BUDGET_MS to 1s-120s, and the effective
# per-request timeout is never larger than the total budget.
AI_TIMEOUT_MS=8000
AI_TOTAL_BUDGET_MS=10000
AI_MAX_RETRIES=1
AI_MAX_TOKENS=4000

# --- Test / debug modes (leave empty in normal use) ------------------------
AI_DRY_RUN=0
AI_FIXTURE_FILE=

# NOTE: the env loader here does not strip quotes. Do NOT wrap an API key in quotes, or the
# quote characters are sent with the key and every call 401s.
