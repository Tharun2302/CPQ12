# CPQ12 log monitor config (copy values to /root/.cpq-monitor/monitor.env)
TEAMS_WEBHOOK_URL=
CPQ_CONTAINER=cpq-application
REPORT_DIR=/root/CPQ12/logs/monitor
STATE_FILE=/root/CPQ12/logs/monitor/.state.json
SCAN_LABEL=CPQ12 User & Error Monitor
MAX_SAMPLE_LINES=12

# --- AI explanation layer -------------------------------------------------
# AI_PROVIDER selects the engine. Leave EMPTY to disable the AI layer entirely
# (the monitor then behaves exactly as it did before this feature).
# Valid values: openai | anthropic
AI_PROVIDER=

# Only the key matching AI_PROVIDER is read. Leave BOTH empty in this example
# file. Real values go ONLY in /root/.cpq-monitor/monitor.env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model. MUST be set to a model your key can actually access.
#   openai    -> suggested default: gpt-5.6-terra   (budget option: gpt-5.6-luna)
#   anthropic -> suggested default: claude-opus-5
# !! CONFIRM YOUR KEY'S ACCESS TO THE MODEL BEFORE ENABLING.                 !!
# !! The model names and prices below were re-checked against OpenAI's live  !!
# !! pricing page on 2026-09-10 and both models exist, but entitlement is    !!
# !! per-account and has NOT been verified for this key. A wrong or          !!
# !! inaccessible name gives a 404/400 -> the monitor logs the rejected      !!
# !! model name, falls back to raw lines and keeps working, but you get no   !!
# !! explanations.                                                           !!
AI_MODEL=

# Optional. Override the API base URL. Use for Azure OpenAI, a proxy, or a
# local stub in testing. If it contains a path, it is used verbatim.
# Azure OpenAI shape (NEEDS VERIFICATION, see design section 5.3.1):
#   https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=<version>
AI_BASE_URL=

# Auth header style. Defaults from AI_PROVIDER; override only for Azure.
# bearer  -> Authorization: Bearer <key>   (OpenAI default)
# x-api-key -> x-api-key: <key>            (Anthropic default)
# api-key -> api-key: <key>                (Azure OpenAI, NEEDS VERIFICATION)
AI_AUTH_STYLE=

# Allow a plain-http and/or loopback AI_BASE_URL. Only for a local test stub — with this unset,
# an http, loopback, link-local or RFC1918 base URL is refused so the API key cannot be sent
# in cleartext or to a cloud metadata endpoint.
AI_ALLOW_INSECURE=

# --- Shared limits (apply identically to both providers) ------------------
AI_EFFORT=low
# 0 disables the AI layer for this scan, like AI_MAX_CALLS_PER_DAY=0.
AI_MAX_GROUPS=8
AI_MAX_CHARS_PER_ERROR=400
AI_MAX_TOTAL_CHARS=6000
AI_MAX_MESSAGE_CHARS=8000
AI_MAX_CALLS_PER_DAY=40
AI_CACHE_TTL_MIN=180
# Clamped in code: AI_TIMEOUT_MS to 1s-60s, AI_TOTAL_BUDGET_MS to 1s-120s, and the effective
# per-request timeout is never larger than the total budget.
AI_TIMEOUT_MS=20000
AI_TOTAL_BUDGET_MS=45000
AI_MAX_RETRIES=1
AI_MAX_TOKENS=4000

# --- Test / debug modes (leave empty in production) -----------------------
AI_DRY_RUN=0
AI_FIXTURE_FILE=
MONITOR_LOG_FILE=

# NOTE: the env loader in monitor-user-logs.cjs does not strip quotes. Do NOT
# wrap an API key in quotes when writing monitor.env, or the quote characters
# are sent with the key and every call 401s.
