# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
env

# Test files (to prevent merge conflicts)
test-*.cjs
verify-*.cjs

# Batch files (to prevent merge conflicts)
start-*.bat
start-*.ps1

# Temporary files
*.tmp
*.temp

# Test coverage output
coverage/

# Microsoft Word temp/lock files
~$*.docx

# Claude Code internal state
.claude/settings.local.json
.claude/worktrees/

# Backup folders created by maintenance scripts
backup-pre-rename-*/
backend-exhibits/.backup-content-rename-*/
backend-templates/.backup-*/

# User-uploaded documents (customer data — never commit)
uploads/documents/*.pdf
uploads/documents/*.docx
uploads/signed/

# Maintenance / one-shot scripts (move to scripts/archive/ if you want them tracked)
audit-content-exhibits.cjs
apply-tier-rename-to-db.cjs
backup-content-collections.cjs
fix-exhibit-planType.cjs
rename-content-exhibits.cjs
rename-content-templates.cjs
rename-docx-content.cjs
restore-content-collections.cjs
scripts/unbold-table-text-in-templates.cjs

# OnlyOffice DocumentServer runtime data (Docker volume) — never commit
onlyoffice-data/

# Postgres database files (Docker volume) — never commit
postgres-data/

# Debug captures from OnlyOffice edit flow — never commit (transient session DOCX files)
onlyoffice-debug/

# Throwaway E2E test harness output (screenshots, audit JSON) — never commit
tmp-e2e/
